CREATE OR REPLACE PROCEDURE show_student_enrollments (
  p_student_id IN students.student_id%TYPE
) AS
  -- Explicit cursor demonstrates OPEN, FETCH, and CLOSE.
  CURSOR c_enrollments IS
    SELECT s.first_name, s.last_name, c.course_code, c.course_name,
           e.final_grade, e.enrollment_date
    FROM students s
    JOIN enrollments e ON e.student_id = s.student_id
    JOIN courses c ON c.course_id = e.course_id
    WHERE s.student_id = p_student_id
    ORDER BY c.course_code;

  v_row c_enrollments%ROWTYPE;
  v_found BOOLEAN := FALSE;
BEGIN
  OPEN c_enrollments;
  LOOP
    FETCH c_enrollments INTO v_row;
    EXIT WHEN c_enrollments%NOTFOUND;
    v_found := TRUE;
    DBMS_OUTPUT.PUT_LINE(
      v_row.first_name || ' ' || v_row.last_name || ' | ' ||
      v_row.course_code || ' - ' || v_row.course_name || ' | Grade: ' ||
      NVL(TO_CHAR(v_row.final_grade), 'Not graded')
    );
  END LOOP;
  CLOSE c_enrollments;

  IF NOT v_found THEN
    DBMS_OUTPUT.PUT_LINE('No enrollments found for student ID ' || p_student_id);
  END IF;
EXCEPTION
  WHEN OTHERS THEN
    IF c_enrollments%ISOPEN THEN CLOSE c_enrollments; END IF;
    RAISE_APPLICATION_ERROR(-20039, 'Could not retrieve enrollments: ' || SQLERRM);
END;
/

